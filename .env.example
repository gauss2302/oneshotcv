NODE_ENV=production

# Public URL served by nginx. Use your HTTPS production origin in production.
PUBLIC_APP_URL=http://localhost
HTTP_PORT=80

# Backend server
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@postgres.example.com:5432/resume_constructor
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
FRONTEND_ORIGIN=http://localhost
AUTH_PUBLIC_URL=http://localhost
INDEPENDENT_BACKEND_URL=http://backend:4000

# Frontend browser-facing URLs. In production these should usually match PUBLIC_APP_URL
# because nginx proxies /api to the backend on the same origin.
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_BACKEND_URL=http://localhost

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Object storage (MinIO or S3-compatible endpoint)
MINIO_ENDPOINT=minio.example.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET_NAME=resume-photos
NEXT_PUBLIC_MINIO_PUBLIC_URL=https://minio.example.com

# Polar (optional)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_PRICE_ID=
