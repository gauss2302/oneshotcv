NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_constructor

# Frontend auth/app URLs
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Independent backend URLs
FRONTEND_ORIGIN=http://localhost:3000
AUTH_PUBLIC_URL=http://localhost:4000
INDEPENDENT_BACKEND_URL=http://localhost:4000

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=resume-photos
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9000

# Polar (optional)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_PRICE_ID=
