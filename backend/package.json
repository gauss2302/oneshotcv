{
  "name": "resume-constructor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts src/infrastructure/db/migrate.ts --format esm --target node20 --platform node --packages external --out-dir dist",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --config vitest.config.ts run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@polar-sh/sdk": "^0.42.2",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "fastify-raw-body": "^5.0.0",
    "minio": "^8.0.6",
    "pg": "^8.16.3",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
